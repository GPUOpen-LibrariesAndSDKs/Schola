[configuration]

entry_symbol = "schola_training_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.x86_64.debug = "./bin/linux/libschola_training.linux.template_debug.x86_64.so"
linux.x86_64.release = "./bin/linux/libschola_training.linux.template_release.x86_64.so"
windows.x86_64.debug = "./bin/windows/schola_training.windows.template_debug.x86_64.dll"
windows.x86_64.release = "./bin/windows/schola_training.windows.template_release.x86_64.dll"
macos.debug = "./bin/macos/libschola_training.macos.template_debug.dylib"
macos.release = "./bin/macos/libschola_training.macos.template_release.dylib"
